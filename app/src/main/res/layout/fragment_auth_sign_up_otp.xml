<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:padding="24dp"
    tools:context=".fragment.auth.signup.SignUpOTPFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OTP CODE VERIFICATION"
        android:textColor="@color/text_color"
        android:textSize="22sp"
        android:fontFamily="@font/montserrat_extrabold"
        android:textAllCaps="true"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tv_otp_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="We have send an OTP code to your email 12***6@gmail.com. Enter the OTP code below to verify."
        android:textColor="@color/text_color"
        android:fontFamily="@font/montserrat_medium"
        android:textSize="14sp"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="12dp"/>

    <LinearLayout
        android:id="@+id/otp_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="40dp">

        <EditText
            android:id="@+id/et_otp_1"
            style="@style/OtpEditTextStyle"
            android:inputType="phone"/>
        <EditText
            android:id="@+id/et_otp_2"
            style="@style/OtpEditTextStyle"
            android:inputType="phone"/>
        <EditText
            android:id="@+id/et_otp_3"
            style="@style/OtpEditTextStyle"
            android:inputType="phone"/>
        <EditText
            android:id="@+id/et_otp_4"
            style="@style/OtpEditTextStyle"
            android:inputType="phone"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Didn't receive email? "
            android:fontFamily="@font/montserrat_medium"
            android:textColor="@color/text_color"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tv_resend_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You can resend code in 36s"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/main_color"
            android:textSize="13sp"/>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_verify_otp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_semibold"
        android:paddingVertical="16dp"
        android:text="VERIFY OTP"
        android:textAllCaps="true"
        android:textSize="20sp"
        android:textColor="@color/btn_text_color"
        app:backgroundTint="@color/main_color"
        app:cornerRadius="30dp"
        android:layout_marginTop="16dp"/>

</LinearLayout>