<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white_main"
    android:padding="20dp"
    tools:context=".SignUpActivity">

    <ImageView
        android:id="@+id/btn_return_signup"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_return"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"/>

    <!-- 2. Tiêu đề "CREATE YOUR ACCOUNT" -->
    <TextView
        android:id="@+id/tv_create_account_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CREATE YOUR ACCOUNT"
        android:fontFamily="@font/montserrat_extrabold"
        android:textColor="@color/black_text"
        android:textSize="24sp"
        android:layout_marginBottom="10dp"/>

    <!-- 3. Mô tả ngắn -->
    <TextView
        android:id="@+id/tv_signup_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/signup_info"
        android:fontFamily="@font/montserrat_medium"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="30dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_email_signup"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:hint="@string/email"
        app:boxBackgroundColor="#EAEAEA"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ed_email_signup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textColor="@android:color/black"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_password_signup"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:hint="@string/password"
        app:boxBackgroundColor="#EAEAEA"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ed_password_signup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- 6. Ô nhập Confirm Password -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_confirm_password_signup"
        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:hint="@string/confirm_password"
        app:boxBackgroundColor="#EAEAEA"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"

        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/ed_confirm_password_signup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- 7. Checkbox "I agree to Terms & Conditions" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="30dp">
        <CheckBox
            android:id="@+id/cb_agree_terms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#990011"
            android:text="@string/confirm_password"/>
        <TextView
            android:id="@+id/tv_terms_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Term & Condition"
            android:textColor="@color/red_main"
            android:textSize="13sp"
            android:fontFamily="@font/montserrat_bold"/>
    </LinearLayout>

    <!-- 8. "Already have an account? Sign In" -->
    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:layout_marginBottom="40dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Already have an account? "
        android:textColor="#AAAAAA"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/tv_sign_in_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign In"
        android:textColor="#990011"
        android:textStyle="bold"
        android:textSize="14sp"/>
</LinearLayout>

    <!-- 9. Nút NEXT -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login"
        android:textAllCaps="true"
        android:fontFamily="@font/montserrat_semibold"
        android:textSize="20sp"
        android:padding="16dp"
        app:cornerRadius="30dp"
        app:backgroundTint="@color/red_main"/>

</LinearLayout>