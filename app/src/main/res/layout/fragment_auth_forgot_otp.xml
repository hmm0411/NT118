<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:padding="30dp"
    tools:context=".fragment.auth.signup.SignUpOTPFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="30dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OTP CODE VERIFICATION"
        android:textColor="@color/text_color"
        android:textSize="22sp"
        android:fontFamily="@font/montserrat_extrabold"
        android:textAllCaps="true"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/tv_otp_instruction"
        style="@style/Subtitle"
        android:justificationMode="inter_word"
        tools:targetApi="26"
        android:text="We have send an OTP code to your email 12***6@gmail.com. Enter the OTP code below to verify." />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/otp_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="40dp">

        <EditText style="@style/OtpEditTextStyle"
            android:layout_marginHorizontal="10dp"
            android:id="@+id/et_otp_1"/>

        <EditText style="@style/OtpEditTextStyle"
            android:layout_marginHorizontal="10dp"
            android:id="@+id/et_otp_2"/>

        <EditText style="@style/OtpEditTextStyle"
            android:layout_marginHorizontal="10dp"
            android:id="@+id/et_otp_3"/>

        <EditText style="@style/OtpEditTextStyle"
            android:layout_marginHorizontal="10dp"
            android:id="@+id/et_otp_4"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Didn't receive email? "
            android:fontFamily="@font/montserrat_medium"
            android:textColor="@color/text_color"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tv_resend_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You can resend code in 36s"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/main_color"
            android:textSize="13sp"/>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_verify_otp"
        style="@style/MyButton.Primary.FullWidth"
        android:paddingVertical="16dp"
        android:text="VERIFY OTP"
        android:layout_marginTop="16dp"/>

</LinearLayout>