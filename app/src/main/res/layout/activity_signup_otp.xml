<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="20dp"
    android:fitsSystemWindows="true"
    tools:context=".OtpActivity">

    <!-- 1. NÚT RETURN -->
    <ImageView
        android:id="@+id/btn_return_otp"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_return"
        app:tint="@color/white"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"/>

    <!-- 2. TIÊU ĐỀ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OTP CODE VERIFICATION"
        android:fontFamily="@font/montserrat_extrabold"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:layout_marginBottom="10dp"/>

    <!-- 3. MÔ TẢ -->
    <TextView
        android:id="@+id/tv_otp_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="We have sent an OTP code to your email..."
        android:fontFamily="@font/montserrat_medium"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:layout_marginBottom="30dp"/>

    <!-- 4. CÁC Ô NHẬP OTP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="30dp">

        <EditText
            android:id="@+id/et_otp_1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:gravity="center"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_margin="5dp"/>

        <EditText
            android:id="@+id/et_otp_2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:gravity="center"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_margin="5dp"/>

        <EditText
            android:id="@+id/et_otp_3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:gravity="center"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_margin="5dp"/>

        <EditText
            android:id="@+id/et_otp_4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:gravity="center"
            android:inputType="numberPassword"
            android:maxLength="1"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_margin="5dp"/>
    </LinearLayout>

    <!-- 5. GỬI LẠI CODE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Didn't receive email?"
            android:textColor="#AAAAAA"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tv_resend_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You can resend code in 36 s"
            android:textColor="@color/red"
            android:textStyle="bold"
            android:textSize="14sp"/>
    </LinearLayout>

</LinearLayout>