<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:padding="30dp"
    tools:context=".fragment.auth.forgot.ForgotResetFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tv_title"
        android:orientation="vertical"
        android:layout_marginBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CREATE NEW PASSWORD"
            android:textColor="@color/text_color"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tv_subtitle"
            style="@style/Subtitle"
            android:justificationMode="inter_word"
            tools:targetApi="26"
            android:text="Create your new password iff you forget it, then you have to do forgot password" />
    </LinearLayout>

        <LinearLayout
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:text="@string/lb_password" />

            <EditText
                android:id="@+id/ed_password"
                style="@style/MyEditText.FormInput"
                android:autofillHints="Enter your password"
                android:drawableStart="@drawable/ic_password"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/input_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:text="@string/lb_confirm_password" />

            <EditText
                android:id="@+id/ed_confirm_password"
                style="@style/MyEditText.FormInput"
                android:autofillHints="Enter your password"
                android:drawableStart="@drawable/ic_password"
                android:hint="@string/hint_confirm_password"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp" />
        </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next"
        style="@style/MyButton.Primary.FullWidth"
        android:text="NEXT"
        android:paddingVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</LinearLayout>