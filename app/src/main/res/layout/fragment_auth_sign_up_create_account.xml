<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/login_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:fitsSystemWindows="true"
    android:padding="30dp"
    android:scrollbarAlwaysDrawHorizontalTrack="false"
    android:scrollbarAlwaysDrawVerticalTrack="false"
    app:layout_scrollFlags="noScroll"
    tools:context=".fragment.auth.signup.SignUpCreateAccountFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/signup_tag"
            android:textAllCaps="true"
            android:fontFamily="@font/montserrat_extrabold"
            android:textColor="@color/text_color"
            android:textSize="21sp"
            android:layout_marginBottom="10dp"/>

        <TextView
            style="@style/Subtitle"
            android:justificationMode="inter_word"
            tools:targetApi="26"
            android:text="@string/signup_info"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/input_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:text="@string/lb_email" />

            <EditText
                android:id="@+id/ed_email"
                style="@style/MyEditText.FormInput"
                android:autofillHints="email"
                android:drawableStart="@drawable/ic_email"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:text="@string/lb_password" />

            <EditText
                android:id="@+id/ed_password"
                style="@style/MyEditText.FormInput"
                android:autofillHints="Enter your password"
                android:drawableStart="@drawable/ic_password"
                android:hint="@string/hint_password"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/input_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:orientation="vertical">

            <TextView
                style="@style/Label"
                android:text="@string/lb_confirm_password" />

            <EditText
                android:id="@+id/ed_confirm_password"
                style="@style/MyEditText.FormInput"
                android:autofillHints="Enter your password"
                android:drawableStart="@drawable/ic_password"
                android:hint="@string/hint_confirm_password"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:paddingVertical="16dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/input_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cb_agree_terms"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:buttonTint="@color/main_color"
                android:fontFamily="@font/montserrat_medium"
                android:gravity="center_vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_marginEnd="5dp"
                android:fontFamily="@font/montserrat_medium"
                android:gravity="center_vertical"
                android:paddingVertical="6dp"
                android:text="@string/agree_license"
                android:textColor="@color/text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_terms_link"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:fontFamily="@font/montserrat_medium"
                android:gravity="center_vertical"
                android:paddingVertical="6dp"
                android:text="@string/license"
                android:textColor="@color/main_color"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="wrap_content"
            android:layout_height="1dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginBottom="15dp"
            android:background="@color/text_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:fontFamily="@font/montserrat_medium"
                android:text="@string/signup_other_tag"
                android:textColor="@color/text_color"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_sign_in_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_medium"
                android:text="@string/sign_in"
                android:textColor="@color/main_color"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            style="@style/MyButton.Primary.FullWidth"
            android:text="@string/btn_next"
            android:paddingVertical="16dp"/>
    </LinearLayout>
</LinearLayout>