<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".fragment.profile.ProfileFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_account_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/main_profile_tag"
            android:textAllCaps="true"
            android:textColor="@color/text_color"
            android:textSize="18sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/view_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <View
            android:id="@+id/view_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line_color"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="100dp">

            <!-- Thông tin User -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/user_info_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:shapeAppearanceOverlay="@style/CircularShapeAppearance"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:src="@mipmap/ic_logo"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toEndOf="@id/iv_avatar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/text_color"
                        android:textSize="16sp"
                        tools:text="Nguyen Hoang Loc" />

                    <TextView
                        android:id="@+id/tv_user_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_medium"
                        android:textColor="@color/text_color"
                        android:textSize="14sp"
                        tools:text="123456@gmail.com" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="#AAAAAA"
                    android:layout_weight="1"/>
            </LinearLayout>

            <LinearLayout style="@style/ProfileOption"
                android:id="@+id/option_watchlist">

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_list"/>

                <TextView style="@style/TextProfileOption"
                    android:text="@string/profile_link_watchlist"/>

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_next"/>
            </LinearLayout>

            <LinearLayout style="@style/ProfileOption"
                android:id="@+id/option_payment_methods">

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_payment"/>

                <TextView style="@style/TextProfileOption"
                    android:text="@string/profile_link_payment"/>

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_next"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="5dp">

                <TextView
                    android:id="@+id/tv_header_general"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_color"
                    android:paddingStart="0dp"
                    android:paddingEnd="8dp"
                    android:text="@string/profile_seperate_general" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/line_color"
                    android:layout_weight="1"/>
            </LinearLayout>

            <LinearLayout style="@style/ProfileOption"
                android:id="@+id/option_personal_info">

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_profile"/>

                <TextView style="@style/TextProfileOption"
                    android:text="@string/profile_link_personal_info"/>

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_next"/>
            </LinearLayout>

            <LinearLayout style="@style/ProfileOption"
                android:id="@+id/option_security">

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_security"/>

                <TextView style="@style/TextProfileOption"
                    android:text="@string/profile_link_security"/>

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_next"/>
            </LinearLayout>

            <LinearLayout style="@style/ProfileOption"
                    android:id="@+id/option_language">

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_language"/>

                <TextView style="@style/TextProfileOption"
                    android:text="@string/profile_link_language"/>

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_next"/>
            </LinearLayout>

            <LinearLayout style="@style/ProfileOption"
                android:id="@+id/option_mode">

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_mode"/>

                <TextView style="@style/TextProfileOption"
                    android:text="@string/profile_link_mode"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_dark_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_color"
                    android:paddingStart="0dp"
                    android:paddingEnd="8dp"
                    android:text="@string/profile_seperate_about" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/line_color"
                    android:layout_weight="1"/>
            </LinearLayout>

            <LinearLayout style="@style/ProfileOption"
                android:id="@+id/option_help">

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_help"/>

                <TextView style="@style/TextProfileOption"
                    android:text="@string/profile_link_help"/>

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_next"/>
            </LinearLayout>

            <LinearLayout style="@style/ProfileOption"
                android:id="@+id/option_about" >

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_about"/>

                <TextView style="@style/TextProfileOption"
                    android:text="@string/profile_link_info"/>

                <ImageView style="@style/Icon.ImageView"
                    android:src="@drawable/ic_next"/>
            </LinearLayout>

            <LinearLayout style="@style/ProfileOption"
                android:layout_width="wrap_content"
                android:id="@+id/btnLogout">

                <ImageView style="@style/Icon.ImageView"
                    app:tint="@color/main_color"
                    android:src="@drawable/ic_logout"/>

                <TextView style="@style/TextProfileOption"
                    android:text="@string/profile_logout"
                    android:textColor="@color/main_color"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/logged_out_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btn_go_to_login"
                    style="@style/MyButton.Primary.FullWidth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingVertical="10dp"
                    android:text="@string/btn_login" />

                <Button
                    android:id="@+id/btn_go_to_signup"
                    style="@style/MyButton.Primary2.FullWidth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:paddingVertical="10dp"
                    android:text="@string/btn_sign_up" />

            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>