<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/rounded_dialog_background"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@mipmap/ic_logo_round"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transaction Failed"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/montserrat_bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_failure_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reason: The payment was cancelled or timed out."
        android:textColor="@color/text_color"
        android:textSize="14sp"
        android:fontFamily="@font/montserrat"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton style="@style/MyButton.Primary2.FullWidth"
        android:id="@+id/btn_cancel_dismiss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dismiss"
        android:paddingVertical="12dp"/>

</LinearLayout>