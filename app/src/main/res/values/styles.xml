<resources>
    <style name="CircularShapeAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

<!--    Subtitle Auth-->
    <style name="Subtitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">8dp</item>
    </style>

<!-- Label Input -->
    <style name="Label" parent="">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/text_color</item>
    </style>

<!-- EditText -->
    <style name="MyEditText.FormInput" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/background_edittext</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textColorHint">@color/hint_color</item>
        <item name="android:drawableTint">@color/text_color</item>
    </style>

<!-- OTP Input-->
    <style name="OtpEditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:background">@drawable/background_edittext_otp</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
    </style>

    <style name="OtpKeypadButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
    </style>

    <style name="ProfileInputLabel" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="ProfileInputEditText" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/background_edittext_otp</item> <item name="android:textColorHint">#AAAAAA</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
    </style>

    <style name="TitleTextStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_color</item>
    </style>

    <style name="ViewAllTextStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:text">@string/view_all</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/main_color</item>
        <item name="android:layout_alignParentEnd">true</item>
        <item name="android:layout_centerVertical">true</item>
    </style>

    <style name="HorizontalRecyclerViewStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
    </style>

    <style name="ShapeAppearance.App.TopCornersRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ProfileOption" parent="">
        <item name ="android:layout_width">match_parent</item>
        <item name ="android:layout_height">wrap_content</item>
        <item name ="android:orientation">horizontal</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="TextProfileOption" parent="ProfileOption">
        <item name ="android:layout_width">wrap_content</item>
        <item name ="android:layout_height">30dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name ="android:layout_weight">1</item>
        <item name ="android:fontFamily">@font/montserrat_semibold</item>
        <item name ="android:textColor">@color/text_color</item>
        <item name ="android:textSize">16sp</item>
    </style>

    <style name="TextProfilePersonal" parent="">
        <item name ="android:layout_weight">1</item>
        <item name ="android:layout_width">wrap_content</item>
        <item name ="android:layout_height">wrap_content</item>
        <item name ="android:textSize">15sp</item>
        <item name ="android:textColor">@color/text_color</item>
        <item name ="android:fontFamily">@font/montserrat_bold</item>
        <item name ="android:layout_marginTop">20dp</item>
        <item name ="android:layout_marginBottom">20dp</item>
        <item name ="android:layout_marginLeft">10dp</item>
        <item name ="android:layout_marginRight">10dp</item>
        <item name ="android:paddingStart">5dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="PaymentOptionCard" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
<!--        <item name="app:cardCornerRadius">12dp</item>-->
<!--        <item name="app:cardElevation">0dp</item>-->
<!--        <item name="app:strokeColor">#E0E0E0</item>-->
<!--        <item name="app:strokeWidth">1dp</item>-->
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="PaymentOptionLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="PaymentOptionIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:scaleType">centerCrop</item>
    </style>

    <style name="PaymentOptionText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SeatLegendText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

<!--    Button Style -->
    <style name="MyButton.Primary" parent="">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">20sp</item>
        <item name="cornerRadius">30dp</item>
        <item name="backgroundTint">@color/main_color</item>
        <item name="android:textColor">@color/btn_text_color</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
    </style>

    <style name="MyButton.Primary.FullWidth" parent="MyButton.Primary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:maxWidth">320dp</item>
    </style>

    <style name="MyButton.Primary2" parent="">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">20sp</item>
        <item name="cornerRadius">30dp</item>
        <item name="backgroundTint">@color/background_color</item>
        <item name="android:textColor">@color/main_color</item>
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/main_color</item>
    </style>

    <style name="MyButton.Primary2.FullWidth" parent="MyButton.Primary2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:maxWidth">320dp</item>
    </style>

    <style name="Icon.ImageView" parent="">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:tint">@color/icon_color</item>
    </style>
</resources>